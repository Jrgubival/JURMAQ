{
  "name": "jurmaq-monorepo",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "next": "16.2.6",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "next-auth": "5.0.0-beta.31"
    }
  },
  "scripts": {
    "dev:barraca": "pnpm --filter @jurmaq/barraca dev",
    "dev:constructora": "pnpm --filter @jurmaq/constructora dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "build:barraca": "pnpm --filter @jurmaq/barraca build",
    "build:constructora": "pnpm --filter @jurmaq/constructora build",
    "lint": "pnpm --recursive --filter \"./apps/*\" lint",
    "typecheck": "pnpm --recursive --filter \"./apps/*\" --filter \"./packages/*\" typecheck"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.1"
}
