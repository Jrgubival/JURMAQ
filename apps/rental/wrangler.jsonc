{
  "$schema": "node_modules/wrangler/config-schema.json",
  // rental.jurmaq.cl en Cloudflare Workers (OpenNext). Los secretos van con
  // `wrangler secret put`, nunca en este archivo ni en .env del build.
  // PENDIENTE antes del primer despliegue: crear el bucket R2 y la base D1,
  // y poner aquí su database_id.
  "name": "jurmaq-rental",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "jurmaq-rental" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "jurmaq-rental-cache" }],
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "jurmaq-rental-tags", "database_id": "PENDIENTE" }
  ],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // Sin Custom Domain todavía: rental.jurmaq.cl se agrega con el OK de Jorge.
  "workers_dev": true,
  "vars": { "AUTH_SCOPE": "rental", "DESPLIEGUE": "cloudflare" },
  "observability": { "enabled": true }
}
