 "L53"}, {"caller_nid": "usuarios_page_usuariosadminpage", "callee": "useState", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/admin/usuarios/page.tsx", "source_location": "L54"}, {"caller_nid": "usuarios_page_usuariosadminpage", "callee": "useState", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/admin/usuarios/page.tsx", "source_location": "L55"}, {"caller_nid": "usuarios_page_usuariosadminpage", "callee": "useEffect", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/admin/usuarios/page.tsx", "source_location": "L78"}, {"caller_nid": "usuarios_page_usuariosadminpage", "callee": "map", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/admin/usuarios/page.tsx", "source_location": "L183"}, {"caller_nid": "usuarios_page_usuariosadminpage", "callee": "(() => {\n                const q = search.trim().toLowerCase();\n                const filtered = q\n                  ? users.filter((u) =>\n                      u.name.toLowerCase().includes(q) || u.email.toLowerCase().includes(q)\n                    )\n                  : users;\n                if (filtered.length === 0) {\n                  return (\n                    <tr>\n                      <td colSpan={5} className=\"px-4 py-12 text-center text-gray-500\">\n                        {q ? `Sin resultados para \"${search}\"` : 'No hay usuarios registrados'}\n                      </td>\n                    </tr>\n                  );\n                }\n                return filtered.map((u) => (\n                  <tr key={u.id} className=\"hover:bg-gray-50\">\n                    <td className=\"px-4 py-3 font-medium text-gray-900\">{u.name}</td>\n                    <td className=\"px-4 py-3 text-gray-600\">{u.email}</td>\n                    <td className=\"px-4 py-3\">\n                      <span className={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold ${roleBadge[u.role] || 'bg-gray-100 text-gray-700'}`}>\n                        {roles.find((r) => r.id === u.role)?.label || u.role}\n                      </span>\n                    </td>\n                    <td className=\"px-4 py-3 text-center text-gray-500 text-xs\">{formatDate(u.created_at)}</td>\n                    <td className=\"px-4 py-3\">\n                      <div className=\"flex gap-2 justify-end\">\n                        <Link\n                          href={`/admin/usuarios/${u.id}`}\n                          className=\"px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50 inline-flex items-center gap-1\"\n                          title=\"Ver detalle y documentos\"\n                        >\n                          Detalle\n                        </Link>\n                        <button\n                          onClick={() => openEdit(u)}\n                          className=\"px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50\"\n                        >\n                          Editar\n                        </button>\n                        {confirmDelete === u.id ? (\n                          <>\n                            <button\n                              onClick={() => handleDelete(u.id)}\n                              className=\"px-2 py-1.5 text-xs font-medium rounded-md bg-red-600 text-white hover:bg-red-700\"\n                            >\n                              S\u00ed, eliminar\n                            </button>\n                            <button\n                              onClick={() => setConfirmDelete(null)}\n                              className=\"px-2 py-1.5 text-xs font-medium rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50\"\n                            >\n                              Cancelar\n                            </button>\n                          </>\n                        ) : (\n                          <button\n                            onClick={() => setConfirmDelete(u.id)}\n                            className=\"px-3 py-1.5 text-xs font-medium rounded-md border border-red-200 text-red-600 hover:bg-red-50\"\n                          >\n                            Eliminar\n                          </button>\n                        )}\n                      </div>\n                    </td>\n                  </tr>\n                ));\n              })", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/admin/usuarios/page.tsx", "source_location": "L224"}, {"caller_nid": "usuarios_page_usuariosadminpage", "callee": "map", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/admin/usuarios/page.tsx", "source_location": "L362"}, {"caller_nid": "usuarios_page_usuariosadminpage", "callee": "find", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/admin/usuarios/page.tsx", "source_location": "L368"}]}