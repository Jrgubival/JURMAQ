.tsx", "source_location": "L323"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "(() => {\n                const desc = getMaquinariaDescripcion(machine.tipo, machine.descripcion);\n                return (\n                  <div className=\"bg-white rounded-2xl border border-[#EAEAEA] p-6 lg:p-8 space-y-6\">\n                    <div>\n                      <p className=\"text-[10px] font-semibold text-[#787774] uppercase tracking-[0.22em] mb-3\">\n                        Descripci\u00f3n del equipo\n                      </p>\n                      <p className=\"text-base text-[#5A5A57] leading-relaxed\">\n                        {desc.intro}\n                      </p>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-[#EAEAEA]\">\n                      <div>\n                        <p className=\"text-[10px] font-semibold text-[#787774] uppercase tracking-[0.22em] mb-3\">\n                          Usos t\u00edpicos\n                        </p>\n                        <ul className=\"space-y-1.5\">\n                          {desc.usos.map((u) => (\n                            <li key={u} className=\"flex items-start gap-2 text-sm text-[#5A5A57]\">\n                              <svg className=\"w-3.5 h-3.5 text-[#956400] shrink-0 mt-1\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n                                <path d=\"m5 12 5 5L20 7\" />\n                              </svg>\n                              <span>{u}</span>\n                            </li>\n                          ))}\n                        </ul>\n                      </div>\n                      <div>\n                        <p className=\"text-[10px] font-semibold text-[#787774] uppercase tracking-[0.22em] mb-3\">\n                          Caracter\u00edsticas t\u00e9cnicas\n                        </p>\n                        <ul className=\"space-y-1.5\">\n                          {desc.caracteristicas.map((c) => (\n                            <li key={c} className=\"flex items-start gap-2 text-sm text-[#5A5A57]\">\n                              <svg className=\"w-3.5 h-3.5 text-[#956400] shrink-0 mt-1\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n                                <path d=\"M9 12h6M12 9v6\" />\n                              </svg>\n                              <span>{c}</span>\n                            </li>\n                          ))}\n                        </ul>\n                      </div>\n                    </div>\n\n                    <div className=\"pt-4 border-t border-[#EAEAEA]\">\n                      <p className=\"text-[10px] font-semibold text-[#787774] uppercase tracking-[0.22em] mb-3\">\n                        Incluye sin costo\n                      </p>\n                      <ul className=\"flex flex-wrap gap-x-6 gap-y-2\">\n                        {desc.incluye.map((i) => (\n                          <li key={i} className=\"flex items-center gap-2 text-sm text-[#5A5A57]\">\n                            <svg className=\"w-3.5 h-3.5 text-[#2F7F4E] shrink-0\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n                              <path d=\"m5 12 5 5L20 7\" />\n                            </svg>\n                            <span>{i}</span>\n                          </li>\n                        ))}\n                      </ul>\n                    </div>\n                  </div>\n                );\n              })", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L382"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "keys", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L448"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "map", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L454"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "entries", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L454"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "Number", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L479"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "Number", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L481"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "whatsappCtaMaquinaria", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L498"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "(() => {\n                const badge = tieneOperadorIncluido(machine.tipo)\n                  ? {\n                      titulo: machine.tipo === \"camion\" ? \"Conductor incluido\" : \"Operador incluido\",\n                      detalle: \"en la tarifa \u2014 no pagas extra\",\n                    }\n                  : TIPOS_OPERA_CLIENTE.has(machine.tipo)\n                    ? { titulo: \"La opera tu equipo\", detalle: \"(curso de operaci\u00f3n vigente)\" }\n                    : null;\n                if (!badge) return null;\n                return (\n                  <div className=\"flex items-center gap-2.5 bg-white rounded-2xl border border-[#EAEAEA] px-5 py-3.5\">\n                    <svg className=\"w-5 h-5 text-[#2F7F4E] shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                    <p className=\"text-sm text-navy-950 leading-snug\">\n                      <span className=\"font-bold\">{badge.titulo}</span>{\" \"}\n                      <span className=\"text-[#6F6F6C]\">{badge.detalle}</span>\n                    </p>\n                  </div>\n                );\n              })", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L511"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "map", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L546"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "stringify", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L612"}, {"caller_nid": "id_page_maquinariadetailpage", "callee": "stringify", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/constructora/src/app/maquinarias/[id]/page.tsx", "source_location": "L619"}]}