# Barraca — variables de la tienda en línea (copiar a .env.local y completar).
# Nunca poner claves reales en este archivo.

# --- Supabase (las mismas de siempre) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_BARRACA_URL=https://barraca.jurmaq.cl

# --- Pago en línea: Mercado Pago Checkout Pro ---
# Pruebas: credenciales de PRUEBA del panel de Mercado Pago (empiezan con TEST-).
# Producción: credenciales de producción de la cuenta de la barraca.
MERCADOPAGO_ACCESS_TOKEN=
# "Clave secreta" de Webhooks en el panel de Mercado Pago (Tus integraciones → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=
# mercadopago (por defecto) | simulado (sólo desarrollo: página local que aprueba/rechaza).
PAGO_PASARELA=

# --- Pedidos ---
# supabase (por defecto, tabla barraca_pedidos) | archivo (sólo desarrollo: .pedidos-dev.json).
PEDIDOS_STORE=
# Correo que recibe el aviso de cada pedido nuevo o pagado.
BARRACA_PEDIDOS_EMAIL=

# --- Transferencia bancaria (se muestran al comprador) ---
BANK_NAME=
BANK_ACCOUNT_TYPE=Cuenta corriente
BANK_ACCOUNT=
BANK_HOLDER=JURMAQ SpA
BANK_RUT=
BANK_EMAIL=

# --- Píxel de Meta (vacío = apagado) ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=

# Vigencia de los precios web (se muestra bajo "Precio web"). Ej: "30 de noviembre de 2026"
NEXT_PUBLIC_PRECIO_WEB_VALIDO_HASTA=
