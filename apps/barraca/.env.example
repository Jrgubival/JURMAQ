# Barraca — variables de la tienda en línea (copiar a .env.local y completar).
# Nunca poner claves reales en este archivo.

# --- Supabase (las mismas de siempre) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_BARRACA_URL=https://barraca.jurmaq.cl

# --- Pago en línea: Webpay Plus (Transbank) ---
# Sin WEBPAY_ENTORNO=produccion se usa el ambiente de INTEGRACIÓN de Transbank con sus
# credenciales públicas de prueba (no se permite en producción).
# Producción: WEBPAY_ENTORNO=produccion + el código de comercio (12 dígitos) y la
# "API Key secreta" que entrega Transbank. Se cargan SOLO en Vercel, nunca en el repo.
WEBPAY_ENTORNO=
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# webpay (por defecto) | simulado (sólo desarrollo: página local que aprueba/rechaza) | mercadopago (antiguo).
PAGO_PASARELA=
# Mercado Pago (ya no se usa; queda por pedidos antiguos).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Pedidos ---
# supabase (por defecto, tabla barraca_pedidos) | archivo (sólo desarrollo: .pedidos-dev.json).
PEDIDOS_STORE=
# Correo que recibe el aviso de cada pedido nuevo o pagado.
BARRACA_PEDIDOS_EMAIL=
# --- Despacho por courier (lo que no es fierro, a todo Chile) ---
# enviame (Envíame) | simulado (sólo desarrollo: tarifas de ejemplo y envíos de prueba). Vacío = sólo camión propio.
COURIER=
# API key e id de empresa de Envíame (panel de Envíame → Mi empresa). Sólo por variable de entorno.
ENVIAME_API_KEY=
ENVIAME_SELLER_ID=
# Código de la bodega de origen creada en Envíame (warehouse_code).
ENVIAME_BODEGA=
# Opcional: base de la API (por defecto https://api.enviame.io/api; pruebas: https://stage.api.enviame.io/api).
ENVIAME_BASE_URL=

# --- Transferencia bancaria (se muestran al comprador) ---
BANK_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT=
BANK_HOLDER=
BANK_RUT=
BANK_EMAIL=

# --- Píxel de Meta (vacío = apagado) ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=


# --- Avisos internos de la tienda (pedidos nuevos, pagados, cotizaciones) ---
# Casilla que recibe los avisos internos y las copias. Vacío = contacto@jurmaq.cl.
BARRACA_AVISOS_EMAIL=

# Obligatorio: login del panel con código por correo (sin esto no se publica en Vercel).
AUTH_SCOPE=barraca
