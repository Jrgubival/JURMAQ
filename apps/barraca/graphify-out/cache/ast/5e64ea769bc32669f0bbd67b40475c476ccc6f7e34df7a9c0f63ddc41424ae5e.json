"is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/components/admin/AdminShell.tsx", "source_location": "L208"}, {"caller_nid": "admin_adminshell_adminshell", "callee": "useSession", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/components/admin/AdminShell.tsx", "source_location": "L209"}, {"caller_nid": "admin_adminshell_adminshell", "callee": "(() => {\n              const role = (session?.user as { role?: string })?.role;\n              const allowedModules = new Set(visibleModules(role));\n              const filtered = navItems.filter((it) => allowedModules.has(it.module));\n              const accentBg = '#ea580c';\n              const accentFg = '#fff';\n\n              const groupOrder: NavGroup[] = ['Operaciones', 'Cat\u00e1logo', 'Ventas', 'Marketing'];\n              const grouped = new Map<NavGroup, NavItem[]>();\n              for (const it of filtered) {\n                if (!grouped.has(it.group)) grouped.set(it.group, []);\n                grouped.get(it.group)!.push(it);\n              }\n\n              return groupOrder\n                .filter((g) => grouped.has(g))\n                .map((group, idx) => (\n                  <div key={group} className={idx > 0 ? 'mt-4' : ''}>\n                    <div className=\"px-3 mb-1 text-[10px] font-bold uppercase tracking-wider text-gray-500\">\n                      {group}\n                    </div>\n                    <div className=\"space-y-0.5\">\n                      {grouped.get(group)!.map((item) => {\n                        const active = isActive(item.href);\n                        return (\n                          <Link\n                            key={item.href}\n                            href={item.href}\n                            onClick={() => setSidebarOpen(false)}\n                            className={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${\n                              active\n                                ? 'text-white'\n                                : 'text-gray-500 hover:text-white hover:bg-white/5'\n                            }`}\n                            style={active ? { backgroundColor: accentBg, color: accentFg } : {}}\n                          >\n                            {item.icon}\n                            {item.label}\n                          </Link>\n                        );\n                      })}\n                    </div>\n                  </div>\n                ));\n            })", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/components/admin/AdminShell.tsx", "source_location": "L269"}, {"caller_nid": "admin_adminshell_adminshell", "callee": "find", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/components/admin/AdminShell.tsx", "source_location": "L367"}, {"caller_nid": "admin_adminshell_adminshell", "callee": "toUpperCase", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/components/admin/AdminShell.tsx", "source_location": "L383"}, {"caller_nid": "admin_adminshell_adminshell", "callee": "charAt", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/components/admin/AdminShell.tsx", "source_location": "L383"}]}