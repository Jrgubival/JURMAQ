-orange-50 hover:text-orange-600 active:bg-orange-100'\n                            }`}\n                          >\n                            {opt.label}\n                          </Link>\n                        ))}\n                      </div>\n                    );\n                  })", "is_member_call": false, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/app/categorias/[slug]/page.tsx", "source_location": "L537"}, {"caller_nid": "slug_page_categoriapage", "callee": "map", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/app/categorias/[slug]/page.tsx", "source_location": "L592"}, {"caller_nid": "slug_page_categoriapage", "callee": "map", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/app/categorias/[slug]/page.tsx", "source_location": "L623"}, {"caller_nid": "slug_page_categoriapage", "callee": "filter", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/app/categorias/[slug]/page.tsx", "source_location": "L623"}, {"caller_nid": "slug_page_categoriapage", "callee": "from", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/app/categorias/[slug]/page.tsx", "source_location": "L623"}, {"caller_nid": "slug_page_categoriapage", "callee": "toLowerCase", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/app/categorias/[slug]/page.tsx", "source_location": "L665"}, {"caller_nid": "slug_page_categoriapage", "callee": "map", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/src/app/categorias/[slug]/page.tsx", "source_location": "L668"}, {"caller_nid": "slug_page_categoriapage", "callee": "slice", "is_member_call": true, "source_file": "/Users/jorgeubilla/Documents/Proyectos/JURMAQ.CL/apps/barraca/s