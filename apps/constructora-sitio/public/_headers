/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://jurmaq.cl; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/obras/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
